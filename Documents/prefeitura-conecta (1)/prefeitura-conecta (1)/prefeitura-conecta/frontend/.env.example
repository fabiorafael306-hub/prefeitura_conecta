# Copie para .env.local se precisar mudar algo.
# Alvo do proxy de desenvolvimento (npm run dev):
VITE_BACKEND_URL=http://localhost:8080
# URL base da API usada pelo navegador. Deixe vazio para usar o proxy (recomendado em dev).
# Em produção, aponte para o backend (ex.: https://api.suaprefeitura.gov.br) e libere a origem no CORS do backend.
VITE_API_URL=
